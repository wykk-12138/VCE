[{"sha":"e11dce59fca0ec83e76f9dae291c2f1b16b02765","node_id":"C_kwDOAOWUd9oAKGUxMWRjZTU5ZmNhMGVjODNlNzZmOWRhZTI5MWMyZjFiMTZiMDI3NjU","commit":{"author":{"name":"Nicolas De Loof","email":"nicolas.deloof@gmail.com","date":"2026-10-08T16:08:02Z"},"committer":{"name":"Guillaume Lours","email":"705411+glours@users.noreply.github.com","date":"2026-10-09T14:41:51Z"},"message":"fix(logs): relay each line of a restarted container exactly once\n\nThe log journal of a container is shared by all its runs, and a followed\nlog stream has no upper bound: it ends with the run in progress when it\nopened. After a restart, compose opens a stream starting at the end of\nthe previous run (d834777e1), but a stream opened late, once the\ncontainer has restarted again (the restart delay is only 100ms, and the\nevent monitor or the daemon can be slower), also returns the next run's\nlines, which that run's own stream then returns a second time.\n\nThe streams of one container now run one at a time, in start-event\norder, and each starts right after the last line the previous ones\nrelayed. Line timestamps are the daemon's own, so no client clock is\ninvolved. A stream opened in time still starts at the previous run's\nend, as before. TTY containers, whose stream is not multiplexed, are\nunchanged.\n\nSigned-off-by: Nicolas De Loof <nicolas.deloof@gmail.com>","tree":{"sha":"b63ba467b07ace9eeaacfc13dbdf3c29832786c3","url":"https://api.github.com/repos/docker/compose/git/trees/b63ba467b07ace9eeaacfc13dbdf3c29832786c3"},"url":"https://api.github.com/repos/docker/compose/git/commits/e11dce59fca0ec83e76f9dae291c2f1b16b02765","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/docker/compose/commits/e11dce59fca0ec83e76f9dae291c2f1b16b02765","html_url":"https://github.com/docker/compose/commit/e11dce59fca0ec83e76f9dae291c2f1b16b02765","comments_url":"https://api.github.com/repos/docker/compose/commits/e11dce59fca0ec83e76f9dae291c2f1b16b02765/comments","author":{"login":"ndeloof","id":132757,"node_id":"MDQ6VXNlcjEzMjc1Nw==","avatar_url":"https://avatars.githubusercontent.com/u/132757?v=4","gravatar_id":"","url":"https://api.github.com/users/ndeloof","html_url":"https://github.com/ndeloof","followers_url":"https://api.github.com/users/ndeloof/followers","following_url":"https://api.github.com/users/ndeloof/following{/other_user}","gists_url":"https://api.github.com/users/ndeloof/gists{/gist_id}","starred_url":"https://api.github.com/users/ndeloof/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ndeloof/subscriptions","organizations_url":"https://api.github.com/users/ndeloof/orgs","repos_url":"https://api.github.com/users/ndeloof/repos","events_url":"https://api.github.com/users/ndeloof/events{/privacy}","received_events_url":"https://api.github.com/users/ndeloof/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"glours","id":705411,"node_id":"MDQ6VXNlcjcwNTQxMQ==","avatar_url":"https://avatars.githubusercontent.com/u/705411?v=4","gravatar_id":"","url":"https://api.github.com/users/glours","html_url":"https://github.com/glours","followers_url":"https://api.github.com/users/glours/followers","following_url":"https://api.github.com/users/glours/following{/other_user}","gists_url":"https://api.github.com/users/glours/gists{/gist_id}","starred_url":"https://api.github.com/users/glours/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/glours/subscriptions","organizations_url":"https://api.github.com/users/glours/orgs","repos_url":"https://api.github.com/users/glours/repos","events_url":"https://api.github.com/users/glours/events{/privacy}","received_events_url":"https://api.github.com/users/glours/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"968d8b29897db57dde59429e777a189a0c57bc9d","url":"https://api.github.com/re