[{"sha":"26de6fbe6ecbb0b8fe093c038259da157ed98021","node_id":"C_kwDOKbIFZdoAKDI2ZGU2ZmJlNmVjYmIwYjhmZTA5M2MwMzgyNTlkYTE1N2VkOTgwMjE","commit":{"author":{"name":"Charlie Marsh","email":"charlie.r.marsh@gmail.com","date":"2026-10-10T22:23:38Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-10T22:23:38Z"},"message":"Disable unsupported filesystem ioctls on SPARC (#22463)\n\nSPARC builds fail because `rustix` does not expose `ioctl_ficlone` and\n`linux-raw-sys` does not provide the FIEMAP constants on these targets.\n\nWe exclude both `sparc` and `sparc64` from the affected Linux paths.\nReflink attempts use `reflink-copy`'s unsupported fallback, allowing\ninstallation to fall back to hardlinks or copies. We also report\nfine-grained space accounting as unsupported, so cache removal uses\ncoarse accounting.\n\nCloses https://github.com/astral-sh/uv/issues/22461.","tree":{"sha":"5444f94c7c5a2ffa24d4538ef44ab8359e684bf7","url":"https://api.github.com/repos/astral-sh/uv/git/trees/5444f94c7c5a2ffa24d4538ef44ab8359e684bf7"},"url":"https://api.github.com/repos/astral-sh/uv/git/commits/26de6fbe6ecbb0b8fe093c038259da157ed98021","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqyrrqCRC1aQ7uu5UhlAAAdgMQAKkxNEyWkiyXib/BaTQrUIew\nUwaw6DM5+Jadw5lDP4TG9FA/dUi+CyJd9u+4sHwZCEKbMZAxgAbrP4ycALZBVKc5\n3qR+kIVcoBQm8Esq3znDHX/G8aJq2iS2hqaX4dFGPUXsmJoFqPHCa6dkdxFxrjF7\nh5CpR0mNFSkb7pnz0OeQYLFsWa2sSYuaIISIdhzqWeN8zpHm2POseHdnjGrfVCkF\nHzOwjYtDh1ywgpBNcC+2va1k8n6XAkgrnLJaghRd0/u6RzkdxMvlMFuPLEBRR0FX\nHVzXW0JS5uX93ioxO4po0XGAqG3mG8ACP3BZVJANx9+gaTqBltWY5fH/MeJZB/ua\nf0C/tybx4m0GBFyW3G+PeSWgQZAYe3gyN8X3U2MU3gblvhCcIrfS1tYZhTzYTSG/\nG/+BRpdY5BW+2K/59VZ2fJrv9Ht/2ZNMp3KfBN5gjkcT76m81bJehgNEW/mktBOh\nviYXrBLyKCShJAYZUD9ckQVwEg8FP1+HFFCXzmZ1nPfusOEV1QiIW180b6r3P/Wp\ndaBXZlhPzWalK3lpuyBX261NUj6TZy/FDxcbr43abUcYf6MOB5RfZNleob6Vp+xm\nXlLHuBlrwFS8Wo4qyhtHTSFoJjDaRQUWi7O70ZSQepHQbzJHPgvqMes8gwly4OBE\nwRVtqNvSduHkpycwT3Im\n=vT2X\n-----END PGP SIGNATURE-----\n","payload":"tree 5444f94c7c5a2ffa24d4538ef44ab8359e684bf7\nparent 44b2e5877ef752e360acc02c7d198ba71ddf948d\nauthor Charlie Marsh <charlie.r.marsh@gmail.com> 1791671018 -0400\ncommitter GitHub <noreply@github.com> 1791671018 +0000\n\nDisable unsupported filesystem ioctls on SPARC (#22463)\n\nSPARC builds fail because `rustix` does not expose `ioctl_ficlone` and\n`linux-raw-sys` does not provide the FIEMAP constants on these targets.\n\nWe exclude both `sparc` and `sparc64` from the affected Linux paths.\nReflink attempts use `reflink-copy`'s unsupported fallback, allowing\ninstallation to fall back to hardlinks or copies. We also report\nfine-grained space accounting as unsupported, so cache removal uses\ncoarse accounting.\n\nCloses https://github.com/astral-sh/uv/issues/22461.","verified_at":"2026-10-10T22:23:38Z"}},"url":"https://api.github.com/repos/astral-sh/uv/commits/26de6fbe6ecbb0b8fe093c038259da157ed98021","html_url":"https://github.com/astral-sh/uv/commit/26de6fbe6ecbb0b8fe093c038259da157ed98021","comments_url":"https://api.github.com/repos/astral-sh/uv/commits/26de6fbe6ecbb0b8fe093c038259da157ed98021/comments","author":{"login":"charliermarsh","id":1309177,"node_id":"MDQ6VXNlcjEzMDkxNzc=","avatar_url":"https://avatars.githubusercontent.com/u/1309177?v=4","gravatar_id":"","url":"https://api.github.com/users/charliermarsh","html_url":"https://github.com/charliermarsh","followers_url":"https://api.github.com/users/charliermarsh/followers","following_url":"https://api.github.com/users/charliermarsh/following{/other_user}","gists_url":"https://api.github.com/users/charliermarsh/gists{/gist_id}","starred_url":"https://api.github.com/users/charliermarsh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/charliermarsh/subscriptions","organizations_url":"https://api.github.com/users/charliermarsh/orgs","repos_url":"https://api.github.com/users/charliermarsh/repos","events_url":"https